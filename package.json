{
  "name": "ai-teaching-assistance-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:inspect": "next dev --inspect",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mjs",
    "test:e2e": "playwright test",
    "eval:validate": "node eval/scripts/collect-course-quality-baseline.mjs --validate-only",
    "eval:smoke": "node eval/scripts/collect-course-quality-baseline.mjs --smoke-mock",
    "eval:baseline": "node eval/scripts/collect-course-quality-baseline.mjs",
    "eval:archive": "node eval/scripts/archive-existing-course-quality-run.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "verify:full": "pnpm lint && pnpm test && pnpm test:db && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "mysql2": "^3.23.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
