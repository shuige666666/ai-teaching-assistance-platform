# M2 起 MySQL 是课程事实的唯一来源；不要在该文件中填写真实密码。
COURSE_REPOSITORY=mysql
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/ai_teaching

# M3 大纲管线读取以下配置；默认 mock，remote 只校验当前选中的 Provider。
AI_MODE=mock
AI_PROVIDER=deepseek
AI_OUTLINE_TIMEOUT_MS=90000
AI_SCENE_TIMEOUT_MS=120000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=
